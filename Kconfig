mainmenu "pocketgen"

source "Kconfig.zephyr"

config POCKETGEN_SELF_TEST
	bool "Run MicroPython integration tests at startup"
	default n

config POCKETGEN_SYNTAX_HIGHLIGHT
	bool "Highlight Python source in the editor"
	default y

config POCKETGEN_HIGHLIGHT_BENCHMARK
	bool "Benchmark editor viewport highlighting at startup"
	default n

choice POCKETGEN_AUTOSTART
	prompt "Demo to run at startup"
	default POCKETGEN_AUTOSTART_NONE
	help
	  Load and run a demo after initializing the display and UART.
	  Ctrl+C interrupts the demo and returns to the editor. Startup
	  integration tests retain their normal maze behavior.

config POCKETGEN_AUTOSTART_NONE
	bool "No automatic execution"

config POCKETGEN_AUTOSTART_CUBE
	bool "3D Cube"

config POCKETGEN_AUTOSTART_MEGA
	bool "Mega Demo"

endchoice
