{
  "name": "pocketgen",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable"
    }
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "/workspaces/zephyrproject/.venv/bin:${containerEnv:PATH}",
    "ZEPHYR_BASE": "/workspaces/zephyrproject/zephyr",
    "ZEPHYR_SDK_INSTALL_DIR": "/workspaces/zephyrproject/.sdk"
  },
  "postCreateCommand": "git submodule update --init && bash .devcontainer/setup.sh"
}